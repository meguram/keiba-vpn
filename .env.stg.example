# Staging 環境変数テンプレート
# cp .env.stg.example .env.stg
# ※ dev と同時起動するため DB ポート=5433 / Redis ポート=6380 を使用

# --- Flask アプリ ---
FLASK_ENV=development
APP_SECRET_KEY=change_me_stg_random_32chars

# --- JWT 認証 ---
JWT_SECRET=change_me_stg_random_32chars

# --- データベース (docker-compose.stg.yml: port 5433) ---
DATABASE_URL=postgresql+psycopg://keiba_user:keiba_pass@localhost:5433/keiba_db_stg

# --- Redis (docker-compose.stg.yml: port 6380) ---
REDIS_URL=redis://localhost:6380/0

# --- 環境識別 ---
KEIBA_ENV=stg
KEIBA_DEPLOYMENT_LABEL=STG

# --- GCS (ローカル stg は無効化) ---
GCS_BUCKET=magu-keiba-horse-racing-ai
KEIBA_GCS_ENABLED=false

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- スクレイピング制約 (DEC-023) ---
NETKEIBA_MAX_CONCURRENT_REQUESTS=1
NETKEIBA_AUTO_LOGIN=0

# --- netkeiba.com (stg テスト用) ---
netkeiba_id=your_email@example.com
netkeiba_pw=your_password

# --- 開発者認証 ---
DEV_PASSWORD=your-stg-dev-password
DEV_SECRET_KEY=your-stg-secret-key
