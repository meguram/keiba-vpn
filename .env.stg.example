# Staging 環境変数テンプレート（stg = 本番データで実行する検証環境）
# cp .env.stg.example .env.stg
# .env（dev共通ベース）の後に KEIBA_ENV=stg のとき上書きマージされる。dev との差分だけ書く。
# .env.stg 自体は git にコミットしない（.gitignore 済み）。
# [要設定] と書かれた行の値はマスク済みのダミー。各自の値に置き換えること。

# --- 実行環境 ---
KEIBA_ENV=stg
KEIBA_DEPLOYMENT_LABEL=STG
FLASK_ENV=production

# --- シークレット ---
# [要設定] ランダムな32文字以上に変更
APP_SECRET_KEY=change_me_stg_random_32chars_xxxxxxxx
JWT_SECRET=change_me_stg_random_32chars_xxxxxxxx
DEV_PASSWORD=your-stg-dev-password
DEV_SECRET_KEY=change_me_stg_random_32chars_xxxxxxxx
MONITOR_PASSWORD=your-stg-monitor-password
MONITOR_SECRET_KEY=change_me_stg_random_32chars_xxxxxxxx

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- GCS / GCP サービスアカウント（GCS・Cloud Tasks・Cloud SQL・BigQuery 共通） ---
# [要設定] サービスアカウントJSONの各フィールドを転記（マスク済みダミー値のままだとGCP接続は失敗する）。
# GCS_PRIVATE_KEY は改行を \n にエスケープして1行で書く。
KEIBA_GCS_ENABLED=true
GCS_BUCKET=magu-keiba-horse-racing-ai
GCS_TYPE=service_account
GCS_PROJECT_ID=your-gcp-project-stg
GCS_PRIVATE_KEY_ID=0000000000000000000000000000000000000000
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMASKED_REPLACE_WITH_YOUR_OWN_KEY\n-----END PRIVATE KEY-----\n"
GCS_CLIENT_EMAIL=service-account@your-gcp-project-stg.iam.gserviceaccount.com
GCS_CLIENT_ID=000000000000000000000
GCS_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/service-account%40your-gcp-project-stg.iam.gserviceaccount.com

# --- Cloud SQL（PostgreSQL。VPS・GCP の両方から接続するため使用） ---
# [要設定] コスト削減のため prod と同一インスタンスを共用し、DB名とユーザーだけ分ける
# （インスタンス作成: scripts/gcp/setup_cloud_sql.sh）。インスタンス接続名は prod と同じ値にする。
KEIBA_DB_BACKEND=cloud_sql
CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-gcp-project-prod:asia-northeast1:keiba-db
CLOUD_SQL_DB_USER=keiba_stg_user
CLOUD_SQL_DB_PASSWORD=your-cloud-sql-stg-password
CLOUD_SQL_DB_NAME=keiba_db_stg

# --- スクレイピングキュー（GCP の Cloud Tasks へ投入。実行は GCP 側 Cloud Run Jobs） ---
KEIBA_QUEUE_BACKEND=cloud_tasks
CLOUD_TASKS_QUEUE=keiba-scrape-queue
CLOUD_TASKS_LOCATION=asia-northeast1
# [要設定] Cloud Run 側ワーカーのURL
CLOUD_RUN_JOBS_WORKER_URL=https://your-worker-url.a.run.app/api/internal/cloud-tasks/process-job
# [要設定] GCPコスト日次通知用: 課金データのBigQueryエクスポート先テーブル（GCPコンソールで事前に有効化）
GCP_BILLING_BQ_TABLE=your-gcp-project-stg.billing_export.gcp_billing_export_v1_XXXXXX

# --- netkeiba.com スクレイピング（実行は GCP 側ジョブ） ---
# [要設定] プレミアム契約アカウント
netkeiba_id=your_email@example.com
netkeiba_pw=your_password
NETKEIBA_AUTO_LOGIN=1
# DEC-023: netkeiba への同時GETは1本（変更しない）
NETKEIBA_MAX_CONCURRENT_REQUESTS=1

# --- 通知 ---
# [任意] Slack Incoming Webhook URL（cron失敗・GCPコスト通知）。空なら通知しない
SLACK_WEBHOOK_URL=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
