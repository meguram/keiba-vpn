# Staging 環境変数テンプレート
# cp .env.stg.example .env.stg
# .env（dev共通ベース）の後に KEIBA_ENV=stg のとき上書きマージされます。実際の値は各自で設定し、
# .env.stg 自体は git にコミットしないでください（.gitignore 済み）。
# ネイティブ PostgreSQL 14 を使用 (port 5432)
# Docker は不要。PostgreSQL が起動済みで keiba_user/keiba_db_stg が存在すること。
# セットアップ: bash scripts/server/setup_stg.sh

# --- Flask アプリ ---
FLASK_ENV=development
APP_SECRET_KEY=change_me_stg_random_32chars

# --- JWT 認証 ---
JWT_SECRET=change_me_stg_random_32chars

# --- データベース (ネイティブ PostgreSQL 14: port 5432) ---
DATABASE_URL=postgresql+psycopg://keiba_user:keiba_pass@localhost:5432/keiba_db_stg

# --- Redis (標準ポート) ---
REDIS_URL=redis://localhost:6379/0

# --- 環境識別 ---
KEIBA_ENV=stg
KEIBA_DEPLOYMENT_LABEL=STG

# --- GCS (stg は GCS を有効化: race_lists 以外のデータを GCS から取得) ---
GCS_BUCKET=magu-keiba-horse-racing-ai
KEIBA_GCS_ENABLED=true

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- スクレイピング制約 (DEC-023) ---
NETKEIBA_MAX_CONCURRENT_REQUESTS=1
NETKEIBA_AUTO_LOGIN=0

# --- netkeiba.com (stg テスト用) ---
netkeiba_id=your_email@example.com
netkeiba_pw=your_password

# --- 開発者認証 ---
DEV_PASSWORD=your-stg-dev-password
DEV_SECRET_KEY=your-stg-secret-key

# --- GCP サービスアカウント認証（GCS / Cloud Tasks / Cloud SQL / BigQuery 共通）---
# すべて「マスク済みのダミー値」です。各自のサービスアカウントJSONの値で置き換えてください。
# GCS_PRIVATE_KEY は改行を \n にエスケープして1行で書きます。
# GCS_PROJECT_ID / GCS_PRIVATE_KEY 等を設定しない場合は ADC（Cloud Run の実行SA等）を使います。
GCS_TYPE=service_account
GCS_PROJECT_ID=your-gcp-project-stg
GCS_PRIVATE_KEY_ID=0000000000000000000000000000000000000000
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMASKED_REPLACE_WITH_YOUR_OWN_KEY\n-----END PRIVATE KEY-----\n"
GCS_CLIENT_EMAIL=service-account@your-gcp-project-stg.iam.gserviceaccount.com
GCS_CLIENT_ID=000000000000000000000
GCS_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/service-account%40your-gcp-project-stg.iam.gserviceaccount.com

# --- Cloud SQL（PostgreSQL。VPS/GCP 双方から接続）---
# KEIBA_DB_BACKEND=cloud_sql
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-gcp-project-stg:asia-northeast1:keiba-db-stg
# CLOUD_SQL_DB_USER=keiba_user
# CLOUD_SQL_DB_PASSWORD=your-cloud-sql-password
# CLOUD_SQL_DB_NAME=keiba_db

# --- GCP 側（Cloud Tasks / コスト通知）---
# KEIBA_QUEUE_BACKEND=cloud_tasks
# CLOUD_TASKS_QUEUE=keiba-scrape-queue
# CLOUD_TASKS_LOCATION=asia-northeast1
# CLOUD_RUN_JOBS_WORKER_URL=https://your-worker-url.a.run.app/api/internal/cloud-tasks/process-job
# GCP_BILLING_BQ_TABLE=your-gcp-project-stg.billing_export.gcp_billing_export_v1_XXXXXX
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
