  "dataset": {
    "period": "2020〜2025年",
    "conditions": "JRA全競馬場・芝ダート（障害除く）。前走のある出走。ブリンカーは各馬の全戦績の装着記録",
    "sample": "初装着 6,558 走・装着なし 195,507 走"
  },
  "body": [
