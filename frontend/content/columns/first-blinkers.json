        {
          "label": "前走より着順が上がった割合",
          "value": "53.0% 対 42.8%",
          "sub": "初装着 対 装着なし。ただし平均への回帰"
        },
        {
          "label": "前走の着順・人気をそろえた複勝率の差",
          "value": "-0.62pt",
          "sub": "初装着 − 装着なし（p=0.167）"
