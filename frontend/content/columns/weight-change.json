        {
          "label": "大幅増（+10kg以上）の複勝率",
          "value": "20.3%",
          "sub": "見込み 20.9%。変わらず 23.2%"
        },
        {
          "label": "うち『太め』の見込みとの差",
          "value": "-0.9pt",
          "sub": "4,897 走。複勝率 18.5%"
        },
        {
          "label": "うち『成長』の見込みとの差",
          "value": "-0.6pt",
          "sub": "14,107 走。複勝率 21.3%"
        }
