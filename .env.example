# keiba-vpn 環境変数テンプレート
# .env にコピーして値を設定してください: cp .env.example .env
#
# 環境別ファイル構成（src/utils/project_env.load_project_dotenv が読み込む）:
#   .env       … dev（共通ベース。KEIBA_ENV 未設定/dev のときはこれだけ読む）
#   .env.stg   … stg（KEIBA_ENV=stg のとき .env の後に上書きマージ）
#   .env.prod  … prod（KEIBA_ENV=prod のとき .env の後に上書きマージ）
# stg/prod では差分（GCS_BUCKET・GCS_* 認証情報・DATABASE_URL 等）だけを書けばよい。
# いずれも .gitignore 済み。秘密情報を git で共有したい場合は SOPS 等で暗号化すること。
#
# Jupyter 等で既定以外のファイルを読む場合（utils.project_env.load_project_dotenv が参照）
# KEIBA_DOTENV_PATH=/absolute/path/to/.env.local

# ============================================================
# AREA-09 正規環境変数マスターリスト（DEC-017）
# ============================================================

# --- Flask アプリ ---
FLASK_ENV=development
# FLASK_ENV=production
APP_SECRET_KEY=change_me_in_production_random_32chars

# --- JWT 認証 ---
JWT_SECRET=change_me_in_production_random_32chars

# --- データベース ---
DATABASE_URL=postgresql://keiba_user:keiba_pass@localhost:5432/keiba_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- GCS オブジェクトストレージ ---
GCS_BUCKET=magu-keiba-horse-racing-ai

# --- GCP全般の認証（GCS/Cloud Tasks/Cloud SQL/BigQuery/Cloud Logging 共通）---
# サービスアカウント認証情報はファイルではなく .env の GCS_* で管理する
# （src/config/gcp_credentials.py の build_gcp_credentials() が全GCPクライアントに渡す）。
# サービスアカウントJSONの各フィールドを以下へ転記する。GCS_PRIVATE_KEY は改行を \n に
# エスケープして1行で書く。dev/stg/prod で別プロジェクト・別アカウントを使う場合は
# .env / .env.stg / .env.prod それぞれに別の値を書く。
# 全て未設定なら ADC（Cloud Run実行時に付与されるサービスアカウント等）へフォールバックする。
# GCS_TYPE=service_account
# GCS_PROJECT_ID=your-gcp-project
# GCS_PRIVATE_KEY_ID=
# GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GCS_CLIENT_EMAIL=service-account@your-gcp-project.iam.gserviceaccount.com
# GCS_CLIENT_ID=
# GCS_CLIENT_CERT_URL=
# GCP_PROJECT_ID=                         # GCS_PROJECT_ID と異なる場合のみ（通常は不要）
# --- GCP側（スクレイピング・ML・スケジュール実行）専用設定 ---
# KEIBA_QUEUE_BACKEND=cloud_tasks         # 既定local。GCP側のCloud Run Jobsで動かす場合に設定
# CLOUD_TASKS_QUEUE=keiba-scrape-queue
# CLOUD_TASKS_LOCATION=asia-northeast1
# CLOUD_RUN_JOBS_WORKER_URL=              # Cloud TasksがPUSHするCloud Run Jobs/サービスのURL
# GCP_BILLING_BQ_TABLE=                   # GCPコストモニタリング用。Cloud Billingの課金データ
#                                          # エクスポート（BigQuery）先テーブルの完全修飾名
#                                          # （例: project.dataset.gcp_billing_export_v1_XXXXXX）。
#                                          # GCPコンソールの「お支払い」→「課金データのエクスポート」
#                                          # →「BigQueryにエクスポート」を事前に有効化しておく必要がある。
#                                          # python -m src.scripts.cloud_jobs.gcp_daily_cost_report が使用
# --- Cloud SQL（PostgreSQL。VPS/GCP双方からアクセスする場合）---
# KEIBA_DB_BACKEND=cloud_sql               # 既定local（DATABASE_URL直結）
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=project:region:instance
# CLOUD_SQL_DB_USER=keiba_user
# CLOUD_SQL_DB_PASSWORD=keiba_pass
# CLOUD_SQL_DB_NAME=keiba_db

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- スクレイピング制約（DEC-023: 並列リクエスト禁止） ---
NETKEIBA_MAX_CONCURRENT_REQUESTS=1

# ============================================================

# --- 実行環境（stg 動作確認）---
# ステージングとして UI バッジ・/api/health・X-Keiba-Env に反映する。GCS は本番と同一でも可。
# KEIBA_ENV=stg
# KEIBA_DEPLOYMENT_LABEL=stg
# ホストが UTC のときログ・date を揃える（推奨）
# TZ=Asia/Tokyo

# --- netkeiba.com ---
# プレミアム契約アカウント（db レース結果の馬別通過・全頭ラップ等に必須）
netkeiba_id=your_email@example.com
netkeiba_pw=your_password
# 起動時・db レース結果取得前のログイン試行（既定 1 = ON）。オフにする場合のみ 0
NETKEIBA_AUTO_LOGIN=1

# ランタイム負荷の上書き: data/queue/queue_load_settings.json（.env より優先。再起動不要。GET/POST /api/scrape-queue/load-settings）
# 同時ジョブ・stagger・ETA表示用秒・netkeiba 同時 in-flight など
# スクレイピングキュー process_queue / API スロットが同時に処理するジョブ数（1〜32。未設定時は 4。負荷・ブロック多いなら 2〜3 推奨）
# SCRAPE_QUEUE_PARALLEL=3
# 一括起動ジョブの開始をずらす（秒×バッチ内インデックス。既定 0.25）
# SCRAPE_QUEUE_STAGGER_SEC=0.25
# キューリーダー process のみ: 失敗ジョブを全件待機に戻し、完了レコードをキューから除去する間隔（秒。既定 3600、0=無効）
# SCRAPE_QUEUE_HOURLY_MAINTENANCE_SEC=3600
# キュー「終了の目安」の粗い計算用：1ジョブあたりの想定秒（既定 10）。実測に合わせて調整。
# SCRAPE_QUEUE_ETA_SEC_PER_JOB=10
# status=precheck のストレージ照会を1ループあたり最大 N 件に分割（数万件を一括だと pending に進まず固まる。未設定時 1200。0 / unlimited で無制限）
# SCRAPE_STORAGE_PRECHECK_MAX_JOBS=1200
# 上記チャンク内で GCS batch をさらに M ジョブ単位に分割（巨大キー集合でハングするのを防ぐ。未設定時 200。0 でサブ分割なし）
# SCRAPE_PRECHECK_GCS_SUBBATCH=200
# プロセス全体で「netkeiba への同時 in-flight GET」上限（各ジョブが別 Session のため要）。未指定時は並列度から 2〜4 程度に自動。0=制限なし
# NETKEIBA_MAX_CONCURRENT_REQUESTS=3
# netkeiba 同一Sessionのurllib3同時接続数（未設定時は SCRAPE_QUEUE_PARALLEL+4 前後。旧5固定だと並列が5本程度で頭打ち）
# NETKEIBA_HTTP_POOL_MAXSIZE=20
# リクエスト間隔（秒）— ブロック多いなら 2.5 / 4.5 程度に
# NETKEIBA_THROTTLE_MIN=2.2
# NETKEIBA_THROTTLE_MAX=4.0
# キュー投入時に overwrite を省略したジョブの既定。1/true なら常に上書き再取得（smart_skip 相当をオフ）
# （ジョブ JSON の overwrite や API の overwrite で上書き可）
# SCRAPE_DEFAULT_OVERWRITE=0

# --- logs/ 保持（API 起動時スレッド: 毎日 12:00 JST ・mtime が保持日数を超えた logs/*.log を削除） ---
# LOGS_RETENTION_DAYS=7
# LOGS_RETENTION_HOUR_JST=12
# LOGS_RETENTION_MINUTE_JST=0
# LOGS_RETENTION_DISABLED=0

# --- GCS (Google Cloud Storage) ---
# このPCからの GCS 書き込みは無効化されています。
# 本番サーバー側の .env に認証情報（GCS_TYPE / GCS_PRIVATE_KEY 等）を設定してください。
# ローカル開発時は KEIBA_GCS_ENABLED=false を設定してください（GCS アクセスをスキップ）。
# KEIBA_GCS_ENABLED=false
GCS_BUCKET=magu-keiba-horse-racing-ai

# --- PostgreSQL / Redis（AREA-03 / AREA-06）---
# DATABASE_URL=postgresql+psycopg://keiba:keiba@localhost:5432/keiba
# REDIS_URL=redis://localhost:6379/0
# KEIBA_DEFAULT_MODEL_VERSION=v1.0.0
# FLASK_PORT=5000

# --- MLflow モデリング・推論（docs/mlflow_platform.md）---
# Tracking（未起動時は mlflow/runs にフォールバック）
# MLFLOW_TRACKING_URI=http://localhost:5000
# KEIBA_MLFLOW_SERVE_TIMEOUT_SEC=30
# Model Serving（モデルキー別。未設定時はローカル Booster → ヒューリスティック）
# KEIBA_MLFLOW_SERVE_TRACKING_DIFFICULTY_URI=http://localhost:5001
# KEIBA_MLFLOW_SERVE_TRACKING_URI=http://localhost:5001
# KEIBA_MLFLOW_SERVE_FINISH_ORDER_URI=http://localhost:5002
# KEIBA_MLFLOW_SERVE_FINAL_ODDS_URI=http://localhost:5003
# KEIBA_MLFLOW_SERVE_KEIBA_LGBM_URI=http://localhost:5010
# KEIBA_MLFLOW_SERVE_PACE_URI=http://localhost:5004
# storage 推論キャッシュ（1=有効）
# KEIBA_TRACKING_DIFFICULTY_CACHE=1
# KEIBA_TRACKING_DIFFICULTY_CACHE_TTL_SEC=86400
# KEIBA_FINISH_ORDER_CACHE=1
# KEIBA_FINAL_ODDS_CACHE=1

# --- ped_tbl（馬単位血統 Parquet）---
# 出馬表 race_shutuba 保存成功後、ローカル horse_pedigree_5gen から欠損 ped_tbl のみ生成（1=有効）
# KEIBA_SYNC_PED_TBL_ON_SHUTUBA=1
# ped_tbl 生成時に 5 世代目種牡馬接木（未設定時は 1）
# KEIBA_PED_TBL_MERGE_GEN5=1

# 構造化 JSON 保存前のスキーマ検証: 1（既定）= 不合格は保存せずキュー failed（schema_validation）
# KEIBA_SCHEMA_STRICT=0

# race_lists 保存直後に race_day_schedule（page_reference）を自動再生成（1/true/yes）
# KEIBA_WRITE_RACE_DAY_SCHEDULE_ON_RACE_LIST=1

# --- 開発者認証 ---
DEV_PASSWORD=your-dev-password
DEV_SECRET_KEY=your-secret-key

# --- 監視ポータル（:9090）---
# 開発者専用の監視ポータルにアクセスするためのパスワード（DEV_PASSWORD とは別に設定）
MONITOR_PASSWORD=your-monitor-password
# Flask セッション署名キー（ランダム 32 文字以上推奨）
MONITOR_SECRET_KEY=change_me_in_production_random_32chars

# --- 通知（cronジョブ失敗等） ---
# Slack Incoming Webhook URL。未設定なら通知は送られない（src/utils/notify.py）
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ─────────────────────────────────────────────────────────────────────────────
# VPS (2GB) 向け省メモリ設定
#
# .env に KEIBA_PROFILE=vps を設定するだけで以下のデフォルトが一括適用される。
# 個別に上書きしたい場合はコメントを外して値を変更してください。
#
# KEIBA_PROFILE=vps
#
# 以下は KEIBA_PROFILE=vps が設定するデフォルト値（個別上書き例）:
# ── HybridStorage メモリ LRU ──
# LOAD_CACHE_MAX_ENTRIES=1500       # 通常: 8000  VPS: 1500  (−25MB)
# LOAD_CACHE_TTL_SEC=1800           # 通常: 3600  VPS: 1800  (TTL 半減)
# DISK_L2_MIN_WEEKLY_ACCESSES=3     # 通常: 2     VPS: 3     (ディスク書き込み削減)
# ── race_detail キャッシュ ──
# RACE_DETAIL_CACHE_MAX=200         # 通常: 2000  VPS: 200   (−最大 360MB)
# ── bloodline 先読み (267MB) ──
# KEIBA_BLOODLINE_PRELOAD=0         # 通常: 1     VPS: 0     (−267MB)
#
# uvicorn worker 数は起動コマンドで指定:
#   通常: uvicorn src.api.app:app --workers 4
#   VPS:  uvicorn src.api.app:app --workers 2   (−100MB)
# ─────────────────────────────────────────────────────────────────────────────
