# keiba-vpn 環境変数テンプレート（dev / 共通ベース）
# cp .env.example .env
#
# ファイル構成: .env = dev（共通ベース） / .env.stg = stg / .env.prod = prod
#   KEIBA_ENV=stg|prod のとき .env の後に .env.<環境> が上書きマージされる（差分だけ書けばよい）。
#   stg/prod で起動するときは環境変数で KEIBA_ENV=stg|prod を指定する（下の KEIBA_ENV=dev より優先される）。
#   テンプレートは .env.stg.example / .env.prod.example。実ファイルは .gitignore 済み。
# [要設定] と書かれた行の値はマスク済みのダミー。各自の値に置き換えること。それ以外は既定の正しい値。

# --- 実行環境 ---
# dev はモックデータで挙動確認する環境（GCS無効）。stg/prod は .env.stg / .env.prod で上書き。
KEIBA_ENV=dev
KEIBA_DEPLOYMENT_LABEL=DEV
FLASK_ENV=development
TZ=Asia/Tokyo
FLASK_PORT=5000

# --- シークレット ---
# [要設定] ランダムな32文字以上に変更
APP_SECRET_KEY=change_me_dev_random_32chars_xxxxxxxx
JWT_SECRET=change_me_dev_random_32chars_xxxxxxxx
DEV_PASSWORD=your-dev-password
DEV_SECRET_KEY=change_me_dev_random_32chars_xxxxxxxx
# 監視ポータル（:9090）。DEV_PASSWORD とは別の値にする
MONITOR_PASSWORD=your-monitor-password
MONITOR_SECRET_KEY=change_me_dev_random_32chars_xxxxxxxx

# --- データベース / Redis（docker compose -f docker-compose.dev.yml up -d の値） ---
DATABASE_URL=postgresql+psycopg://keiba_user:keiba_pass@localhost:5432/keiba_db
REDIS_URL=redis://localhost:6379/0
# 既定の接続方式（DATABASE_URL 直結）。Cloud SQL を使う stg/prod のみ cloud_sql に上書きされる
KEIBA_DB_BACKEND=local

# --- GCS / GCP サービスアカウント（GCS・Cloud Tasks・Cloud SQL・BigQuery 共通） ---
# dev は GCS を使わない（モックデータ）。stg/prod で有効化し、認証情報は .env.stg / .env.prod に書く。
# KEIBA_ENV=dev では GCS_BUCKET / GCS_* の値に関わらず GCP へ接続しない（コードで強制。src/config/gcp_guard.py）。
# dev のデータは data/dev_mock（make dev-mock で生成）を読む。誤接続防止のため dev では空のままにする。
GCS_BUCKET=
# dev は認証不要のため空のまま（空ならADCにフォールバック）。GCS_PRIVATE_KEY 等は stg/prod で設定
GCS_TYPE=service_account
GCS_PROJECT_ID=
GCS_PRIVATE_KEY_ID=
GCS_PRIVATE_KEY=
GCS_CLIENT_EMAIL=
GCS_CLIENT_ID=
GCS_CLIENT_CERT_URL=

# --- キュー（dev はローカルJSONキュー。Cloud Tasks は stg/prod で有効化） ---
KEIBA_QUEUE_BACKEND=local

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
KEIBA_DEFAULT_MODEL_VERSION=v1.0.0
# Model Serving URI（KEIBA_MLFLOW_SERVE_*）は未設定でよい（ローカルBooster→ヒューリスティックにフォールバック）。
# 詳細: docs/html/design/mlflow_platform.html

# --- netkeiba.com スクレイピング ---
# [要設定] プレミアム契約アカウント（レース結果の馬別通過・全頭ラップ等に必須）。dev のモック確認だけなら不要
netkeiba_id=your_email@example.com
netkeiba_pw=your_password
NETKEIBA_AUTO_LOGIN=1
# DEC-023: netkeiba への同時GETは1本（変更しない）
NETKEIBA_MAX_CONCURRENT_REQUESTS=1
NETKEIBA_THROTTLE_MIN=2.2
NETKEIBA_THROTTLE_MAX=4.0

# --- スクレイピングキュー（既定値のまま可。ブロックが多い場合は PARALLEL を 2〜3 に下げる） ---
# ランタイム上書き: data/queue/queue_load_settings.json（.env より優先・再起動不要）
SCRAPE_QUEUE_PARALLEL=4
SCRAPE_QUEUE_STAGGER_SEC=1.0
SCRAPE_QUEUE_HOURLY_MAINTENANCE_SEC=3600
SCRAPE_QUEUE_ETA_SEC_PER_JOB=10
SCRAPE_STORAGE_PRECHECK_MAX_JOBS=1200
SCRAPE_PRECHECK_GCS_SUBBATCH=200
SCRAPE_DEFAULT_OVERWRITE=0

# --- データ処理 ---
# スキーマ検証: 1 = 不合格は保存せずキュー failed（schema_validation）
KEIBA_SCHEMA_STRICT=1
# 出馬表保存後に ped_tbl を自動生成（0=OFF）。5世代目種牡馬の接木は 1=ON
KEIBA_SYNC_PED_TBL_ON_SHUTUBA=0
KEIBA_PED_TBL_MERGE_GEN5=1
# race_lists 保存直後に race_day_schedule を自動再生成（0=OFF）
KEIBA_WRITE_RACE_DAY_SCHEDULE_ON_RACE_LIST=0

# --- logs/ 保持（API起動時スレッド。毎日12:00 JSTに保持日数超過の logs/*.log を削除） ---
LOGS_RETENTION_DAYS=7
LOGS_RETENTION_HOUR_JST=12
LOGS_RETENTION_MINUTE_JST=0
LOGS_RETENTION_DISABLED=0

# --- 通知 ---
# [任意] Slack Incoming Webhook URL（cron失敗・GCPコスト通知）。空なら通知しない
SLACK_WEBHOOK_URL=

# --- データ存在チェック（python -m src.data_health / make data-health） ---
# 既定のままで動く。環境ごとに変えたい値は .env.stg / .env.prod に書く（KEIBA_ENV に応じて自動で上書きされる）。
# DATA_HEALTH_ENV=stg                 # 評価する要件プロファイル（既定: KEIBA_ENV）。dev PC で stg の要件を見る dry-run 用
# DATA_HEALTH_SINCE=2020-01-01        # 評価期間（既定: stg/prod=2020-01-01, dev=90日前 〜 いずれも実行日の前日まで）
# DATA_HEALTH_UNTIL=
# DATA_HEALTH_FAIL_ON=fail            # fail|warn|never（終了コード 2 にする重大度。cron/CI 用）
# DATA_HEALTH_OUT_DIR=                # 結果の保存ルート（既定 data/local/meta/data_health。直下に <環境>/ を作る）
# DATA_HEALTH_LEVELS=race_barometer=required,C07=optional   # 重要度の上書き（required|recommended|optional|skip）
# DATA_HEALTH_LEVELS_PROD=infra.redis=required               # その環境のときだけ有効（汎用より優先）
# DATA_HEALTH_SKIP=infra.redis,C07    # 評価しない ID
# DATA_HEALTH_VALIDATE=full           # 健全性(スキーマ適合)の検証範囲 off|sample|full。full は範囲内の全データ（台帳で差分だけ再検証）
# DATA_HEALTH_VALIDATE_BUDGET=5000    # full のとき 1 回で download する最大件数（0=無制限。dev は 0）。複数回の実行で全件に到達
# DATA_HEALTH_VALIDATE_WORKERS=8      # 検証の並列数
# DATA_HEALTH_COMPLETE_LEVELS=required,recommended   # 「2020年以降が全部揃っているか」(--require-complete) に含める重要度（optional を足すと厳密）
# --- スキーマ違反の記録（保存時。どの項目がどの値で引っかかったか）。既定で有効 ---
# KEIBA_SCHEMA_VIOLATION_LOG=1        # data/local/meta/schema_violations/<category>.jsonl に記録（0 で無効）
# KEIBA_SCHEMA_QUARANTINE=1           # 拒否したデータ本体を data/local/quarantine/ に隔離（0 で無効）
# DATA_HEALTH_SCHEMA_SAMPLE=20        # sample モードの検証件数（カテゴリごとの最新 N 件）
# DATA_HEALTH_HORSE_PAST_DAYS=30      # 馬の評価窓（過去/先の日数、最大レース数）
# DATA_HEALTH_HORSE_FUTURE_DAYS=14
# DATA_HEALTH_HORSE_RACES_MAX=300
