# VPS 構成の変数（ホスト名など）。コピーして vars.env にして使う（vars.env は git 管理しない）。値に秘密は入れない。
# 例: cp vars.env.example vars.env && 編集 → VPS 側のスクリプトは /etc/keiba-ui/vars.env を読む
PROD_HOST=app.megu-keiba.com                  # ユーザーが開く prod（VPS の UI）
STG_HOST=stg.megu-keiba.com                   # 検証用 stg（ホスト機の UI。Access: オーナーのメール）
UPSTREAM_HOST=api-internal.megu-keiba.com     # VPS の UI が API を取りにいく先（ホスト機の Next.js :23200 へのトンネル。Access: Service Auth のみ）
CLOUDRUN_HOST=                                # Cloud Run の API のホスト名（keiba-api-xxxx-an.a.run.app。https:// なし）。switch_api_upstream.sh cloudrun で使う（空なら未使用）
TEST_HOST=prod-test.megu-keiba.com            # 切替前の動作確認用（VPS のトンネルに一時的に付ける）
SSH_HOST=ssh.megu-keiba.com                   # VPS への SSH 用（Cloudflare Tunnel 経由。公開の SSH ポートを閉じる場合）
SSH_PORT=<SSH_PORT>                                 # この VPS の SSH ポート（ConoHa のセキュリティグループ名 SSH-<SSH_PORT>。既定の 22 ではない）
# VPS 上の配置
APP_ROOT=/srv/keiba-ui
APP_PORT=3000                                 # Next.js（127.0.0.1 のみ）
PROXY_PORT=8080                               # nginx（127.0.0.1 のみ。cloudflared の転送先）
KEEP_RELEASES=5
