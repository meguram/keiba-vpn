[Unit]
Description=keiba 定期実行の見張り — VPS のタイマーの状態を GCS の ops/heartbeat/vps/status.json に書き、赤の発生・解消だけ Slack
After=network-online.target
Wants=network-online.target
# Cloud Run を起こさない（GCS への書き込み 1 回だけ）。監視ポータルと毎朝の点検がこの記録を読む。config/scheduled_jobs.json の vps-sched-status

[Service]
Type=oneshot
Slice=keiba-fetch.slice
User=keibafetch
Group=keibafetch
# systemctl show を読むだけ（root は要らない）
WorkingDirectory=/opt/keiba-fetch/current
EnvironmentFile=/etc/keiba-fetch/fetch.env
EnvironmentFile=-/etc/keiba-ui/slack.env
Environment=KEIBA_ENV=prod KEIBA_RUN_LOCATION=vps PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/keiba-fetch/venv/bin/python -m src.ops.sched_status
TimeoutStartSec=120
OOMScoreAdjust=500
# google.cloud.storage の import で約 53MB（keiba-mirror-vps-push と同じ枠）
MemoryHigh=90M
MemoryMax=110M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/keiba-fetch
SyslogIdentifier=keiba-sched-status
