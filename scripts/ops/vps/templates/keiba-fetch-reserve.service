[Unit]
Description=keiba 取得の予約（定期のタスクを VPS のローカルのタスク表に積む。GCP を使わない）
After=network-online.target
Wants=network-online.target
# 2026-11: 取得を VPS の中だけで完結させる方針。GCP の reserve-fetch-tasks（毎時）の代わり。タスク表は /var/lib/keiba-fetch/tasks（KEIBA_FETCH_TASK_STORE=file）
# 担当タスク（config/fetch_owner.json の agent_tasks）が空なら何も積まない

[Service]
Type=oneshot
Slice=keiba-fetch.slice
User=keibafetch
Group=keibafetch
WorkingDirectory=/opt/keiba-fetch/current
EnvironmentFile=/etc/keiba-fetch/fetch.env
Environment=KEIBA_ENV=prod KEIBA_RUN_LOCATION=vps PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# タスク表は必ずローカル（EnvironmentFile の値は Environment= より優先されるので、ExecStart で上書きして GCS のタスク表に書かない）
ExecStart=/usr/bin/env KEIBA_FETCH_TASK_STORE=file KEIBA_FETCH_TASK_DIR=/var/lib/keiba-fetch/tasks /opt/keiba-fetch/venv/bin/python -m src.ops.reservations recurring --horizon-hours 6
TimeoutStartSec=300
# 実測のピーク（2026-11-13）: 定期の予約 27MB、開催日の予約 66MB。取得役と同じ slice（250M）で重なっても収まるように小さく取る
OOMScoreAdjust=500
MemoryHigh=50M
MemoryMax=60M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/keiba-fetch
SyslogIdentifier=keiba-fetch-reserve
