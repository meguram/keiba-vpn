[Unit]
Description=keiba VPS が取ったレース一覧・発走時刻表を ops/mirror_vps/ に上げる（担当が移った木の、変わったものだけ。ホストが取り込む）
After=network-online.target
Wants=network-online.target
# docs/operations/vps_only_fetch.md の段 1。差分は手元の記録（data/local/meta/gcs_mirror_vps_manifest.json）で判定し、GCS は一覧しない

[Service]
Type=oneshot
Slice=keiba-fetch.slice
User=keibafetch
Group=keibafetch
WorkingDirectory=/opt/keiba-fetch/current
EnvironmentFile=/etc/keiba-fetch/fetch.env
Environment=KEIBA_ENV=prod KEIBA_RUN_LOCATION=vps PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/keiba-fetch/venv/bin/python -m src.ops.gcs_mirror push-vps
TimeoutStartSec=300
OOMScoreAdjust=500
# google.cloud.storage の import だけで約 53MB（ホストで実測）。VPS の venv で実測して見直す
MemoryHigh=90M
MemoryMax=110M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/keiba-fetch
SyslogIdentifier=keiba-mirror-vps-push
