# ローカル上書き（任意）
# cp scripts/server/service_start.local.env.example scripts/server/service_start.local.env
#
# ポート番号の既定は config/ports.env。ここや環境変数で上書きする場合は KEIBA_PORT_* を使う:
# KEIBA_PORT_DEV_FLASK=23999
# KEIBA_PORT_DEV_FRONTEND=23998
# （FLASK_PORT / PORT / FRONTEND_PORT / KEIBA_API_URL を直接上書きすることも可能）
# KEIBA_NPM_STAGING=/tmp/keiba-vpn-npm-staging
# START_MLFLOW_LOCAL=false
# KEIBA_AUTO_TCPEXPOSER=0   # ワークスペース起動時の tcpexposer 自動接続をオフ
