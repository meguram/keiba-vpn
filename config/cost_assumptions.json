  "scenarios": {
    "A_budget_core": {
      "description": "【第一案・2026-10-21 改訂】UI=VPS(常駐は Next.js standalone・nginx・cloudflared・ヘルスチェックのみ、前払い済み)。API・予測生成・集計・通知・ドリフト監視・Slack は GCP(Cloud Run 最小 0 + Cloud Run Jobs + Cloud Scheduler/Cloud Tasks)。VPS には『取得の薄い実行役』(GCS のタスクを pull して実行、MemoryMax あり)だけを置く。データは GCS(東京)、公開スナップショットは R2。",
      "components": [
        "cloud_run_service",
        "cloud_run_jobs",
        "gcs",
        "scheduler",
        "secret_manager",
        "artifact_registry",
        "logging",
        "cloudflare_r2"
      ],
      "usage": {
        "low": {
          "cloud_run_service": {
            "requests": 50000,
            "avg_seconds": 0.3,
            "vcpu": 1,
            "gib": 2,
            "cold_starts": 150,
            "cold_seconds": 8,
            "min_instances": 0
          },
          "cloud_run_jobs": {
            "vcpu_seconds": 60000,
            "gib_seconds": 130000
          },
          "gcs": {
            "stored_gb": 20,
            "class_a_ops": 150000,
            "class_b_ops": 845000,
            "egress_gb": 1.0
          },
          "scheduler": {
            "jobs": 6
          },
          "secret_manager": {
            "versions": 6
          },
          "artifact_registry": {
            "gb": 1.0
          },
          "logging": {
            "gib": 5
          },
          "cloudflare_r2": {
            "stored_gb": 1,
            "class_a_ops": 30000,
            "class_b_ops": 1000000
          }
        },
        "high": {
          "cloud_run_service": {
            "requests": 420000,
            "avg_seconds": 0.5,
            "vcpu": 1,
            "gib": 2,
            "cold_starts": 600,
            "cold_seconds": 10,
            "min_instances": 0
          },
          "cloud_run_jobs": {
            "vcpu_seconds": 170000,
            "gib_seconds": 440000
          },
          "gcs": {
            "stored_gb": 100,
            "class_a_ops": 600000,
            "class_b_ops": 4045000,
            "egress_gb": 8.0
          },
          "scheduler": {
            "jobs": 14
          },
          "secret_manager": {
            "versions": 10
          },
          "artifact_registry": {
            "gb": 2.5
          },
          "logging": {
            "gib": 20
          },
          "cloudflare_r2": {
            "stored_gb": 5,
            "class_a_ops": 100000,
            "class_b_ops": 6000000
          }
        }
      },
      "_notes": "requests にはハートビート(5 分おき 約 8,640 回)・アラート判定(15 分おき)を含む。class_b_ops には VPS の実行役が 60 秒おきに GCS のタスクを確認する分(約 4.3 万回)を含む。Scheduler は 6〜14 ジョブ(無料 3)。"
    },
    "B_scrape_on_cloud_run_jobs": {
      "description": "A に加えて、開催日ランナー・前日取得・夜間取得も GCP(Cloud Run Jobs)で実行する案。VPS の実行役を使わない。送信元 IP が固定でなく、GCP の IP からの到達は未検証(要試験)。",
      "extends": "A_budget_core",
      "components_add": [],
      "usage_add": {
        "low": {
          "cloud_run_jobs": {
            "vcpu_seconds": 90000,
            "gib_seconds": 90000
          }
        },
        "high": {
          "cloud_run_jobs": {
            "vcpu_seconds": 260000,
            "gib_seconds": 260000
          }
        }
      }
    },
    "C_api_min_instance_1": {
      "description": "A に加えて、API の最小インスタンスを常時 1 にしてコールドスタートをなくす案(1 vCPU / 2GiB)。",
      "extends": "A_budget_core",
      "usage_override": {
        "low": {
          "cloud_run_service": {
            "min_instances": 1,
            "cold_starts": 0
          }
        },
        "high": {
          "cloud_run_service": {
            "min_instances": 1,
            "cold_starts": 0
          }
        }
      }
    },
    "D_cloud_sql": {
      "description": "A に加えて、Cloud SQL(PostgreSQL, db-f1-micro)を常設する案(従来の確定案)。",
      "extends": "A_budget_core",
      "components_add": [
        "cloud_sql"
      ],
      "usage_add": {
        "low": {
          "cloud_sql": {
            "instances": 1
          }
        },
        "high": {
          "cloud_sql": {
            "instances": 1
          }
        }
      }
    },
    "E_gce_tokyo_resident": {
      "description": "A に加えて、東京の e2-micro(常時起動、外部 IPv4 付き)を『GCP の常駐機』として置く案。無料枠は米国のみなので東京は有料。",
      "extends": "A_budget_core",
      "components_add": [
        "gce"
      ],
      "usage_add": {
        "low": {
          "gce": {
            "instances": 1,
            "disk_gb": 20
          }
        },
        "high": {
          "gce": {
            "instances": 1,
            "disk_gb": 30
          }
        }
      }
    },
    "F_literal_all_gcp": {
      "description": "ユーザー方針を文字どおりに実装した場合の上限: API 最小インスタンス 1 + Cloud SQL + 東京 e2-micro(取得用常駐機) + Cloud NAT(固定 IP)。",
      "extends": "C_api_min_instance_1",
      "components_add": [
        "cloud_sql",
        "gce",
        "cloud_nat"
      ],
      "usage_add": {
        "low": {
          "cloud_sql": {
            "instances": 1
          },
          "gce": {
            "instances": 1,
            "disk_gb": 20
          },
          "cloud_nat": {
            "enabled": 0
          }
        },
        "high": {
          "cloud_sql": {
            "instances": 1
          },
          "gce": {
            "instances": 1,
            "disk_gb": 30
          },
          "cloud_nat": {
            "enabled": 1
          }
        }
      }
    }
  }
