{
  "version": 1,
  "_doc": "一般公開（不特定多数）の画面・API に出してよい項目の許可リスト。正はこのファイル。仕様・分類表: docs/operations/public_data_inventory.md。規約: netkeiba 利用規約 第14条（データ等を不特定多数が知りうる状態におくのは私的利用の範囲外）・第15条（営利目的は不可）。",
  "mode": "private",
  "_mode_doc": "private=現状（Cloudflare Access で所有者のみ。従来の匿名/会員の出し分けだけ）。public=一般公開用。匿名・会員（開発者以外）には A 分類（自前計算）だけを出し、B/C/O 分類は release の許可が true になるまで出さない。環境変数 KEIBA_PUBLIC_MODE=public|private で上書きできる。開発者（所有者・私的利用）は常に全項目。",
  "release": {
    "minimal_identifiers_public": false,
    "b_facts_public": true,
    "odds_derived_public": true,
    "actual_odds_public": false,
    "_doc": "minimal_identifiers_public=馬番・馬名・レースの識別だけ一般に出す／b_facts_public=出馬表・結果などの事実（B）を一般に出す／actual_odds_public=実オッズ（netkeiba 由来の市場オッズそのもの。単勝/複勝オッズ・人気・実オッズから 1:1 で出る生の期待値・確定払戻）を開発者以外に出す（既定 false。情報元の許可が取れるまで false。想定オッズ・較正後の期待値・印は対象外）／odds_derived_public=市場オッズ由来（オッズ・人気・期待値・買い目）を一般に出す。取得元（JRA-VAN などの正式ライセンス、権利者の承認など）が確定してから true にする。"
  },
  "classes": {
    "A": "自前計算（勝率・連対率・複勝率・印・展開予想・めぐ指数など）。公開できる",
    "B": "取得した事実（出馬表・結果・払戻・コース・馬体重）。取得元が確定するまで一般には出さない",
    "C": "取得元に固有で代替が難しい（指数・パドック・バロメーター・厩舎コメント・調教・過去走の表・馬/騎手/調教師の ID と成績・SmartRC）。一般には出さない",
    "O": "市場オッズに由来（オッズ・人気・期待値・買い目のオッズ）。期待値と勝率からオッズを逆算できるため、オッズと同じ扱い"
  },
  "predictions": {
    "top_always": ["race_id", "status", "has_prediction", "total_horses", "predictions", "model_type", "model_version", "model_description", "prediction_source", "prediction_note", "entries_status", "pipeline_status", "provisional_entries", "freshness", "error", "message", "_mock"],
    "top_identifiers": ["race_name", "venue", "round", "date", "start_time", "grade", "surface", "distance", "track_condition"],
    "top_A_member": ["position_forecast", "tracking_v2", "l3f_coherent", "pace_forecast", "gate_bias", "pace_unified", "pace_type", "scenario_forecast", "lap_forecast", "expected_megu", "expected_megu_meta", "growth", "growth_meta", "class_benchmark"],
    "top_O": ["bet_suggestion", "prob_calibration", "ev_calibrated"],
    "entry_A_anonymous": ["win_prob", "top3_prob", "show_prob", "pred_rank"],
    "entry_A_member": ["top2_prob", "place_prob", "win_prob_model", "top3_prob_model", "pred_score", "normalized_score", "composite_score", "composite_rank", "mark_type", "recommendation", "megu_mark", "kesi_reason", "position_forecast", "tracking_v2", "l3f_coherent", "expected_megu", "expected_megu_meta", "growth", "growth_meta", "class_benchmark"],
    "entry_actual_odds": [
    "win_odds", "place_odds_min", "place_odds_max", "place_odds_avg", "place_odds_eff", "top2_odds_est", "popularity", "odds_source",
    "ev_win", "ev_place", "ev_top2", "expected_value"
  ],
  "top_actual_odds": ["bet_suggestion"],
  "entry_O": ["win_odds", "place_odds_min", "place_odds_max", "place_odds_avg", "place_odds_eff", "top2_odds_est", "popularity", "ev_win", "ev_place", "ev_top2", "ev_win_cal", "ev_place_cal", "ev_top2_cal", "expected_value", "estimated_prob", "buy_tier", "prob_calibrated", "odds_source"],
    "entry_identifiers": ["horse_number", "horse_name"],
    "entry_B": ["horse_number", "horse_name", "bracket_number", "sex_age", "jockey_name", "jockey_weight", "trainer_name", "weight", "weight_change"],
    "entry_C": ["horse_id", "jockey_id", "trainer_id", "sire", "dam_sire"]
  },
  "race_detail": {
    "header_identifiers": ["race_id", "race_name", "venue", "round", "date", "start_time", "surface", "distance", "grade", "track_condition", "direction", "weather"],
    "B_keys": ["race_shutuba", "race_result", "race_result_lap", "horses"],
    "O_keys": ["race_odds", "race_pair_odds"],
    "C_keys": ["race_index", "race_paddock", "race_barometer", "race_trainer_comment", "smartrc_race", "race_shutuba_past", "race_oikiri"],
    "shutuba_entry_B": ["horse_number", "horse_name", "bracket_number", "sex_age", "jockey_name", "jockey_weight", "trainer_name", "weight", "weight_change"],
    "shutuba_entry_O": ["odds", "popularity"],
    "result_entry_B": ["horse_number", "horse_name", "bracket_number", "sex_age", "jockey_name", "jockey_weight", "trainer_name", "weight", "weight_change", "finish_position", "finish_status", "finish_time", "time_sec", "margin", "last_3f", "passing_order"],
    "result_entry_O": ["odds", "popularity"]
  },
  "paths_public_mode": {
    "owner_only": [
      "^/api/race/[^/]+/entry/",
      "^/api/horse/",
      "^/api/v1/horse/",
      "^/api/race/[^/]+/(tracking-difficulty|bundle|bloodline-aptitude)",
      "^/api/v1/races/[^/]+/(final-odds|megu-index|megu-index-predicted|tracking-difficulty|predictions/laps)"
    ],
    "owner_only_unless_odds_derived": [
      "^/api/v1/betting/",
      "^/api/prediction-results"
    ],
    "owner_only_unless_b_facts": [
      "^/api/race-list/",
      "^/api/race-quality/"
    ]
  }
}
