# keiba-vpn ローカルサーバのポート定義（唯一の正）
#
# 方針: 3000/5000/5432/6379/8000/8080/9090 など他プロジェクト・既定値と衝突しやすい番号を避け、
#       Linux の ephemeral 範囲（32768-60999）の外にある 23xxx に集約する。
#       環境ごとに 100 刻み: dev=231xx / stg=232xx / prod=233xx / 共通=239xx
#
# 読み込み: bash は scripts/server/ports.sh、Python は src/config/ports.py
# 上書き  : 同名の環境変数（例: KEIBA_PORT_DEV_FLASK=23999 ./service_start）が優先される
# 形式    : KEY=整数 のみ（コメント・空行可）。シェル展開は書かないこと

# ── dev（モック UI 確認用） ──
KEIBA_PORT_DEV_FRONTEND=23100
KEIBA_PORT_DEV_FLASK=23110
KEIBA_PORT_DEV_FASTAPI=23120
KEIBA_PORT_DEV_MLFLOW=23130

# ── stg（本 PC・本番相当） ──
KEIBA_PORT_STG_FRONTEND=23200
KEIBA_PORT_STG_FLASK=23210
KEIBA_PORT_STG_FASTAPI=23220
KEIBA_PORT_STG_MLFLOW=23230

# ── prod（VPS クローン想定） ──
KEIBA_PORT_PROD_FRONTEND=23300
KEIBA_PORT_PROD_FLASK=23310
KEIBA_PORT_PROD_FASTAPI=23320
KEIBA_PORT_PROD_MLFLOW=23330

# ── 全環境共通 ──
KEIBA_PORT_MONITOR=23900

# 対象外: PostgreSQL(5432) / Redis(6379) は DATABASE_URL / REDIS_URL で明示設定する基盤サービスのため標準ポートのまま。
#        docker-compose.serving.yml・mlflow/server（VPS デプロイ用スタック）も対象外。
