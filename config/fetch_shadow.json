{
  "version": 1,
  "_comment": "VPS の取得の『影モード』の設定。ホストが取得を続けたまま、VPS の実行役が同じ取得を shadow/<日付>/ 以下に保存して本番と比べる（docs/operations/vps_agent.md の影モードの章）。有効化は KEIBA_FETCH_SHADOW_ENABLED=1（既定オフ）。 2026-10-22: 取得元への負荷を最小にするため、対象を比較に必要な軽いタスクだけに絞り（entries-sync・race-odds-t60/t15・race-weight-check・daily-race-lists）、1日の上限を 2,500 から 800 に下げた。制限の疑いが出たら人が解除するまで再開しない（docs/operations/scraping_policy.md）。",
  "tasks": {
    "entries-sync": {
      "est_requests": 25,
      "compare": "shutuba_stable",
      "categories": [
        "race_shutuba"
      ],
      "min_task_days": 2,
      "jitter": [
        30,
        120
      ]
    },
    "race-odds-t60": {
      "est_requests": 2,
      "compare": "odds",
      "categories": [
        "race_odds"
      ],
      "min_task_days": 1,
      "jitter": [
        10,
        90
      ]
    },
    "race-odds-t15": {
      "est_requests": 12,
      "compare": "odds",
      "categories": [
        "race_odds",
        "race_pair_odds"
      ],
      "min_task_days": 1,
      "jitter": [
        10,
        60
      ]
    },
    "race-weight-check": {
      "est_requests": 1,
      "compare": "weights",
      "categories": [
        "race_shutuba"
      ],
      "min_task_days": 1,
      "jitter": [
        10,
        60
      ],
      "thin": 3
    },
    "daily-race-lists": {
      "est_requests": 6,
      "compare": "none",
      "categories": [],
      "min_task_days": 5,
      "jitter": [
        60,
        300
      ]
    }
  },
  "limits": {
    "max_requests_per_day": 800,
    "access_pause_seconds": 3600,
    "max_restrictions_per_day": 1
  },
  "pass": {
    "required_days": 5,
    "require_raceday_days": 1,
    "min_success_rate": 0.95,
    "max_skipped_ratio": 0.1,
    "min_match_ratio": 0.95,
    "max_alerts": 0,
    "odds_rtol": 0.15,
    "odds_horse_ok_ratio": 0.9
  }
}