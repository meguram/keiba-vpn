# Production 環境変数テンプレート（マスク済みのダミー値。実際の値は各自で設定する）
# cp .env.prod.example .env.prod
# .env（dev共通ベース）の後に KEIBA_ENV=prod のとき上書きマージされます。
# .env.prod 自体は git にコミットしないでください（.gitignore 済み）。
# 本番VPS（ConoHa）はサービング専用。重い処理（スクレイピング・ML・バッチ）は GCP 側で実行します。
# 詳細: docs/operations/deployment-vps-vs-gcp.md / docs/operations/cicd-design.md

# --- 環境識別 ---
KEIBA_ENV=prod
KEIBA_DEPLOYMENT_LABEL=PROD
FLASK_ENV=production

# --- シークレット（必ず推測困難なランダム値に変更）---
APP_SECRET_KEY=change_me_prod_random_32chars
JWT_SECRET=change_me_prod_random_32chars
DEV_PASSWORD=your-prod-dev-password
DEV_SECRET_KEY=change_me_prod_random_32chars
MONITOR_PASSWORD=your-prod-monitor-password
MONITOR_SECRET_KEY=change_me_prod_random_32chars

# --- データベース（Cloud SQL 経由を推奨。下の KEIBA_DB_BACKEND を参照）---
DATABASE_URL=postgresql+psycopg://keiba_user:keiba_pass@localhost:5432/keiba_db

# --- Redis（VPS 上の自己ホスト。docker-compose.serving.yml の redis）---
REDIS_URL=redis://redis:6379/0

# --- GCS ---
GCS_BUCKET=magu-keiba-horse-racing-ai
KEIBA_GCS_ENABLED=true

# --- VPS 省メモリプロファイル（2GB）---
KEIBA_PROFILE=vps

# --- netkeiba（スクレイピングは GCP 側。VPS には不要なら未設定でよい）---
NETKEIBA_MAX_CONCURRENT_REQUESTS=1
# netkeiba_id=your_email@example.com
# netkeiba_pw=your_password

# --- GCP サービスアカウント認証（GCS / Cloud Tasks / Cloud SQL / BigQuery 共通）---
# すべて「マスク済みのダミー値」です。各自のサービスアカウントJSONの値で置き換えてください。
# GCS_PRIVATE_KEY は改行を \n にエスケープして1行で書きます。
# GCS_PROJECT_ID / GCS_PRIVATE_KEY 等を設定しない場合は ADC（Cloud Run の実行SA等）を使います。
GCS_TYPE=service_account
GCS_PROJECT_ID=your-gcp-project-prod
GCS_PRIVATE_KEY_ID=0000000000000000000000000000000000000000
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMASKED_REPLACE_WITH_YOUR_OWN_KEY\n-----END PRIVATE KEY-----\n"
GCS_CLIENT_EMAIL=service-account@your-gcp-project-prod.iam.gserviceaccount.com
GCS_CLIENT_ID=000000000000000000000
GCS_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/service-account%40your-gcp-project-prod.iam.gserviceaccount.com

# --- Cloud SQL（PostgreSQL。VPS/GCP 双方から接続）---
# KEIBA_DB_BACKEND=cloud_sql
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-gcp-project-prod:asia-northeast1:keiba-db-prod
# CLOUD_SQL_DB_USER=keiba_user
# CLOUD_SQL_DB_PASSWORD=your-cloud-sql-password
# CLOUD_SQL_DB_NAME=keiba_db

# --- GCP 側（Cloud Tasks / コスト通知）---
# KEIBA_QUEUE_BACKEND=cloud_tasks
# CLOUD_TASKS_QUEUE=keiba-scrape-queue
# CLOUD_TASKS_LOCATION=asia-northeast1
# CLOUD_RUN_JOBS_WORKER_URL=https://your-worker-url.a.run.app/api/internal/cloud-tasks/process-job
# GCP_BILLING_BQ_TABLE=your-gcp-project-prod.billing_export.gcp_billing_export_v1_XXXXXX
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
