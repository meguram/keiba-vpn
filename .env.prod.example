# Production 環境変数テンプレート（prod = 本番データで実行する本番環境）
# cp .env.prod.example .env.prod
# .env（dev共通ベース）の後に KEIBA_ENV=prod のとき上書きマージされる。dev との差分だけ書く。
# .env.prod 自体は git にコミットしない（.gitignore 済み）。
# [要設定] と書かれた行の値はマスク済みのダミー。各自の値に置き換えること。
# 本番VPS（ConoHa 2GB）はサービング専用。スクレイピング・ML・バッチは GCP 側で実行する。
# 詳細: docs/operations/deployment-vps-vs-gcp.md / docs/operations/cicd-design.md

# --- 実行環境 ---
KEIBA_ENV=prod
KEIBA_DEPLOYMENT_LABEL=PROD
FLASK_ENV=production
# VPS(2GB) 省メモリ設定（LRU縮小・bloodline先読みOFF等を一括適用。詳細 src/config/profiles.py）
KEIBA_PROFILE=vps

# --- シークレット ---
# [要設定] ランダムな32文字以上に変更
APP_SECRET_KEY=change_me_prod_random_32chars_xxxxxxx
JWT_SECRET=change_me_prod_random_32chars_xxxxxxx
DEV_PASSWORD=your-prod-dev-password
DEV_SECRET_KEY=change_me_prod_random_32chars_xxxxxxx
MONITOR_PASSWORD=your-prod-monitor-password
MONITOR_SECRET_KEY=change_me_prod_random_32chars_xxxxxxx

# --- Redis（docker-compose.serving.yml の redis サービス） ---
REDIS_URL=redis://redis:6379/0

# --- GCS / GCP サービスアカウント（GCS・Cloud Tasks・Cloud SQL・BigQuery 共通） ---
# [要設定] サービスアカウントJSONの各フィールドを転記（マスク済みダミー値のままだとGCP接続は失敗する）。
# GCS_PRIVATE_KEY は改行を \n にエスケープして1行で書く。
KEIBA_GCS_ENABLED=true
GCS_BUCKET=magu-keiba-horse-racing-ai
GCS_TYPE=service_account
GCS_PROJECT_ID=your-gcp-project-prod
GCS_PRIVATE_KEY_ID=0000000000000000000000000000000000000000
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMASKED_REPLACE_WITH_YOUR_OWN_KEY\n-----END PRIVATE KEY-----\n"
GCS_CLIENT_EMAIL=service-account@your-gcp-project-prod.iam.gserviceaccount.com
GCS_CLIENT_ID=000000000000000000000
GCS_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/service-account%40your-gcp-project-prod.iam.gserviceaccount.com

# --- Cloud SQL（PostgreSQL。VPS・GCP の両方から接続するため使用） ---
# [要設定] インスタンス接続名 / パスワード（インスタンス作成: scripts/gcp/setup_cloud_sql.sh）。
# stg と同一インスタンスを共用するため、インスタンス名は stg と同じ値にする。
KEIBA_DB_BACKEND=cloud_sql
CLOUD_SQL_INSTANCE_CONNECTION_NAME=your-gcp-project-prod:asia-northeast1:keiba-db
CLOUD_SQL_DB_USER=keiba_user
CLOUD_SQL_DB_PASSWORD=your-cloud-sql-prod-password
CLOUD_SQL_DB_NAME=keiba_db

# --- スクレイピングキュー（GCP の Cloud Tasks へ投入。実行は GCP 側 Cloud Run Jobs） ---
KEIBA_QUEUE_BACKEND=cloud_tasks
CLOUD_TASKS_QUEUE=keiba-scrape-queue
CLOUD_TASKS_LOCATION=asia-northeast1
# [要設定] Cloud Run 側ワーカーのURL
CLOUD_RUN_JOBS_WORKER_URL=https://your-worker-url.a.run.app/api/internal/cloud-tasks/process-job
# [要設定] GCPコスト日次通知用: 課金データのBigQueryエクスポート先テーブル（GCPコンソールで事前に有効化）
GCP_BILLING_BQ_TABLE=your-gcp-project-prod.billing_export.gcp_billing_export_v1_XXXXXX

# --- netkeiba.com スクレイピング（実行は GCP 側ジョブ） ---
# [要設定] プレミアム契約アカウント
netkeiba_id=your_email@example.com
netkeiba_pw=your_password
NETKEIBA_AUTO_LOGIN=1
# DEC-023: netkeiba への同時GETは1本（変更しない）
NETKEIBA_MAX_CONCURRENT_REQUESTS=1

# --- 通知 ---
# [任意] Slack Incoming Webhook URL（cron失敗・GCPコスト通知）。空なら通知しない
SLACK_WEBHOOK_URL=

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000

# --- データ存在チェック（prod = VPS。設定の一覧は .env.example 末尾） ---
# VPS は配信専用のため、学習側の派生データは対象外にできる
# DATA_HEALTH_SKIP=C07,D01b,D02,D05
# DATA_HEALTH_FAIL_ON=fail
